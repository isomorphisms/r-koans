Package: tidyversekoans
Title: Colleen O'Briant Teaches the Tidyverse
Version: 0.0.0.9000
Authors@R:
    c(
      person(given = "Colleen", family = "O'Briant", role = "aut"),
      person(given = "ChatGPT", family = "OpenAI", role = "ctb",
             comment = "Anthology reformatting, August 2026")
